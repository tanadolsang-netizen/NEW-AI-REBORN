# Comma-separated list of allowed CORS origins. If unset: dev ENV allows
# localhost:3000 only, non-dev ENV allows https://astral.app only.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: override where branches.py reads tradition markdown from
# (defaults to <repo>/raw/astrology).
# ASTRO_RAW_DIR=

# Optional: override where the /v1/memory proxy looks for Hermes Agent's
# local memory store (defaults to D:\AI\AOS\hermes). HERMES_STATE_DB
# defaults to <HERMES_MEMORY_ROOT>\state.db.
# HERMES_MEMORY_ROOT=
# HERMES_STATE_DB=
